diff --git a/src/hoplog.rs b/src/hoplog.rs
new file mode 100644
index 0000000..0df71a7
--- /dev/null
+++ b/src/hoplog.rs
@@ -0,0 +1,73 @@
+//! Ticket 002-07 diagnostic logging: one rate-limited line per hop of the
+//! loss-counter chain (hop 1 per-input counter, hop 2 echo-header write,
+//! hop 3 sender-side copy, hop 4 stats store, hop 5 display). Logging only:
+//! nothing here changes any POC behaviour, it only emits lines on stderr.
+//!
+//! Every line has the shape
+//!
+//! ```text
+//! [<elapsed s>] hop=<1..5> module=<name> <fields ...>
+//! ```
+//!
+//! and is rate-limited to at most 10 lines per second per hop and module
+//! (a simple last-emit-time check), so the instrument can follow datagram
+//! rates of thousands per second without flooding the log.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::fmt;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+/// Minimum spacing between two log lines of the same hop and module:
+/// 0.1 s = at most 10 lines per second.
+const MIN_INTERVAL: f64 = 0.1;
+
+thread_local! {
+    /// Name of the module running on the current (real-time) thread, set
+    /// once when the thread starts. Both synth instances therefore log as
+    /// `synth1` / `synth2` from the same code path.
+    static MODULE: RefCell<String> = RefCell::new(String::new());
+}
+
+fn slots() -> &'static Mutex<HashMap<(u8, String), Instant>> {
+    static SLOTS: OnceLock<Mutex<HashMap<(u8, String), Instant>>> = OnceLock::new();
+    SLOTS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+fn epoch() -> &'static Instant {
+    static EPOCH: OnceLock<Instant> = OnceLock::new();
+    EPOCH.get_or_init(Instant::now)
+}
+
+/// Remember the module name of the current thread (called once when the
+/// module's real-time thread starts).
+pub fn set_module(name: &str) {
+    MODULE.with(|m| *m.borrow_mut() = name.to_string());
+}
+
+/// Emit one diagnostic line for `hop`, attributed to the module named for
+/// the current thread. Dropped silently when the same hop and module logged
+/// less than `MIN_INTERVAL` ago.
+pub fn emit(hop: u8, args: fmt::Arguments<'_>) {
+    let module = MODULE.with(|m| m.borrow().clone());
+    emit_as(hop, &module, args);
+}
+
+/// Emit one diagnostic line for `hop` from an explicitly named module (for
+/// threads that are not a module's real-time thread, e.g. stats or tui).
+pub fn emit_as(hop: u8, module: &str, args: fmt::Arguments<'_>) {
+    let mut slots = match slots().lock() {
+        Ok(s) => s,
+        Err(_) => return,
+    };
+    let now = Instant::now();
+    let key = (hop, module.to_string());
+    if let Some(t) = slots.get(&key) {
+        if now.duration_since(*t).as_secs_f64() < MIN_INTERVAL {
+            return;
+        }
+    }
+    slots.insert(key, now);
+    eprintln!("[{:>6.1}s] hop={} module={} {}", now.duration_since(*epoch()).as_secs_f64(), hop, module, args);
+}
