+//! Ticket 002-10 diagnostic logging: once per second, a module's real-time
+//! thread prints a distribution summary of (i) the kernel→userspace wake
+//! lateness of every datagram it received and (ii), when the module has a
+//! ticker, the lateness of every tick fire — deadline vs actual tick time,
+//! the quantity ticket 002-10 measures. Logging only: the accumulators live
+//! beside the POC's state, nothing here changes any behaviour, and the
+//! summary is one line per second on stderr, shaped like the hoplog lines:
+//!
+//! ```text
+//! [<elapsed s>] ticklog module=<name> in0=<n> .. wake_n=<n> wake_p50_us=<x> wake_p99_us=<x> wake_max_us=<x> [tick_n=<n> tick_p50_us=<x> tick_p99_us=<x> tick_max_us=<x>]
+//! ```
+//!
+//! Distributions without sorting: a fixed histogram with 1 µs linear
+//! buckets up to 8191 µs and power-of-two buckets beyond, so a percentile
+//! costs one bucket scan on the real-time thread — no sort, no allocation.
+//! The maximum is kept exactly in nanoseconds.
+
+use std::cell::RefCell;
+use std::time::{Duration, Instant};
+
+/// Linear buckets of 1 µs each: 0 .. 8191 µs.
+const LIN: usize = 8192;
+/// Power-of-two buckets beyond the linear range (8192 µs, 16 ms, ...).
+const LOG: usize = 32;
+const BUCKETS: usize = LIN + LOG;
+/// Input sockets counted per second (the POC's mixer has 3).
+const INPUTS: usize = 8;
+
+thread_local! {
+    static MODULE: RefCell<String> = RefCell::new(String::new());
+    static ACC: RefCell<Acc> = RefCell::new(Acc::new());
+}
+
+struct Acc {
+    inputs: [u64; INPUTS],
+    wake: [u64; BUCKETS],
+    wake_max: i64,
+    tick: [u64; BUCKETS],
+    tick_max: i64,
+    next: Option<Instant>,
+}
+
+impl Acc {
+    fn new() -> Acc {
+        Acc {
+            inputs: [0; INPUTS],
+            wake: [0; BUCKETS],
+            wake_max: 0,
+            tick: [0; BUCKETS],
+            tick_max: 0,
+            next: None,
+        }
+    }
+
+    /// Histogram bucket of a lateness in ns.
+    fn bucket(ns: i64) -> usize {
+        let us = (ns.max(0) / 1000) as usize;
+        if us < LIN {
+            return us;
+        }
+        let r = us / LIN; // >= 1
+        let e = usize::BITS - 1 - r.leading_zeros(); // floor(log2 r)
+        (LIN + e as usize).min(BUCKETS - 1)
+    }
+
+    /// Start of a bucket, in µs (the resolution a percentile is reported at).
+    fn bucket_start_us(bucket: usize) -> f64 {
+        if bucket < LIN {
+            bucket as f64
+        } else {
+            (LIN as f64) * (1u64 << (bucket - LIN)) as f64
+        }
+    }
+
+    /// Value in µs at which the cumulative count reaches `pct` % of `total`.
+    fn percentile(hist: &[u64; BUCKETS], total: u64, pct: u64) -> f64 {
+        let mut cum = 0u64;
+        for (b, &c) in hist.iter().enumerate() {
+            cum += c;
+            if cum * 100 >= total * pct {
+                return Acc::bucket_start_us(b);
+            }
+        }
+        Acc::bucket_start_us(BUCKETS - 1)
+    }
+
+    /// Count of a histogram (overflow buckets make 0 impossible for data).
+    fn count(hist: &[u64; BUCKETS]) -> u64 {
+        hist.iter().sum()
+    }
+}
+
+
+/// Remember the module name of the current thread (called once when the
+/// module's real-time thread starts).
+pub fn set_module(name: &str) {
+    MODULE.with(|m| *m.borrow_mut() = name.to_string());
+}
+
+/// One datagram was received, `ns` ns after its kernel receive timestamp.
+pub fn wake(ns: i64) {
+    ACC.with(|a| {
+        let mut acc = a.borrow_mut();
+        let bucket = Acc::bucket(ns);
+        acc.wake[bucket] += 1;
+        acc.wake_max = acc.wake_max.max(ns);
+    });
+}
+
+/// One datagram was received on input `idx` of this module.
+pub fn input(idx: usize) {
+    if idx < INPUTS {
+        ACC.with(|a| a.borrow_mut().inputs[idx] += 1);
+    }
+}
+
+/// One ticker fire happened `ns` ns after its deadline.
+pub fn tick(ns: i64) {
+    ACC.with(|a| {
+        let mut acc = a.borrow_mut();
+        let bucket = Acc::bucket(ns);
+        acc.tick[bucket] += 1;
+        acc.tick_max = acc.tick_max.max(ns);
+    });
+}
+
+/// Emit the summary line when the current second is over; otherwise cheap.
+pub fn flush() {
+    let now = Instant::now();
+    ACC.with(|a| {
+        let mut acc = a.borrow_mut();
+        let next = acc.next.get_or_insert(now + Duration::from_secs(1));
+        if now < *next {
+            return;
+        }
+        *next += Duration::from_secs(1);
+        emit(&mut acc);
+    });
+}
+
+fn emit(acc: &mut Acc) {
+    let module = MODULE.with(|m| m.borrow().clone());
+    let wake_n = Acc::count(&acc.wake);
+    let tick_n = Acc::count(&acc.tick);
+    if wake_n == 0 && tick_n == 0 {
+        return;
+    }
+    let mut line = format!("[{:>6.1}s] ticklog module={module}", epoch_elapsed_s());
+    for (i, c) in acc.inputs.iter().enumerate() {
+        if *c > 0 {
+            line.push_str(&format!(" in{i}={c}"));
+        }
+    }
+    if wake_n > 0 {
+        line.push_str(&format!(
+            " wake_n={wake_n} wake_p50_us={:.1} wake_p99_us={:.1} wake_max_us={:.3}",
+            Acc::percentile(&acc.wake, wake_n, 50),
+            Acc::percentile(&acc.wake, wake_n, 99),
+            acc.wake_max as f64 / 1000.0
+        ));
+    }
+    if tick_n > 0 {
+        line.push_str(&format!(
+            " tick_n={tick_n} tick_p50_us={:.1} tick_p99_us={:.1} tick_max_us={:.3}",
+            Acc::percentile(&acc.tick, tick_n, 50),
+            Acc::percentile(&acc.tick, tick_n, 99),
+            acc.tick_max as f64 / 1000.0
+        ));
+    }
+    eprintln!("{line}");
+    acc.inputs = [0; INPUTS];
+    acc.wake = [0; BUCKETS];
+    acc.tick = [0; BUCKETS];
+    acc.wake_max = 0;
+    acc.tick_max = 0;
+}
+
+/// Seconds since this thread's first flush, to shape the line like hoplog's.
+fn epoch_elapsed_s() -> f64 {
+    use std::sync::OnceLock;
+    static EPOCH: OnceLock<Instant> = OnceLock::new();
+    EPOCH.get_or_init(Instant::now).elapsed().as_secs_f64()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn buckets_cover_the_range() {
+        assert_eq!(Acc::bucket(0), 0);
+        assert_eq!(Acc::bucket(999), 0); // < 1 µs
+        assert_eq!(Acc::bucket(1_000_000), 1000); // 1 ms -> the 1 ms bucket
+        assert_eq!(Acc::bucket(8_191_000), 8191); // last linear µs bucket
+        assert_eq!(Acc::bucket(8_192_000), LIN); // first power-of-two bucket
+        assert_eq!(Acc::bucket(16_384_000), LIN + 1);
+        assert_eq!(Acc::bucket(i64::MAX), BUCKETS - 1);
+        assert_eq!(Acc::bucket(-5), 0);
+    }
+
+    #[test]
+    fn percentile_walks_the_histogram() {
+        let mut h = [0u64; BUCKETS];
+        for (i, v) in h.iter_mut().enumerate().take(100) {
+            *v = 1; // buckets 0..99 µs, one sample each
+            let _ = i;
+        }
+        assert_eq!(Acc::percentile(&h, 100, 50), 49.0); // the 50th of 0..99
+        assert_eq!(Acc::percentile(&h, 100, 99), 98.0);
+        assert_eq!(Acc::percentile(&h, 100, 100), 99.0);
+    }
+}
